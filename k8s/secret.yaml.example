# 지금 앱은 시크릿을 쓰지 않는다. DB·LLM 채점이 들어오면 쓸 자리다.
#   cp k8s/secret.yaml.example k8s/secret.yaml   # k8s/.gitignore 가 막아 준다
#   kubectl -n study-platform apply -f k8s/secret.yaml
# 키는 그 기능을 구현하는 PR 에서 정한다. 여기에는 실제 값을 절대 적지 않는다.
apiVersion: v1
kind: Secret
metadata:
  name: study-platform-web
type: Opaque
stringData:
  EXAMPLE_KEY: "<여기에 값을 넣지 말고 secret.yaml 에 넣는다>"
