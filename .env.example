# cp .env.example .env   (전부 선택. 주석을 풀어 바꾼다)
# 공개 레포다. 실제 값이 든 .env 는 커밋하지 않는다.

# 웹 접속 주소. 로그인이 없으므로 0.0.0.0 으로 열면 같은 네트워크의 누구나 볼 수 있다.
#WEB_BIND=127.0.0.1
#WEB_PORT=8090

# 이미지 태그 (규칙: docs/SELF_HOSTING.md)
#IMAGE_TAG=local

# 1 이면 검수 전(draft) 강의 콘텐츠 미리보기. 빌드 때 새겨지므로 바꾼 뒤 --build 가 필요하다.
#NEXT_PUBLIC_SHOW_DRAFT=0

# pipeline 전용. Linux 에서는 `id -u`, `id -g` 값으로 맞춘다.
#HOST_UID=1000
#HOST_GID=1000
#STUDY_RAW_HOST_DIR=/absolute/path/outside/this/repo
